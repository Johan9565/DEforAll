{
  "name": "@deforall/custom-doc-editor",
  "version": "0.1.0",
  "description": "Document editor library built on TipTap with physical page layout (Letter/A4)",
  "type": "module",
  "main": "./dist/custom-doc-editor.umd.js",
  "module": "./dist/custom-doc-editor.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-doc-editor.es.js",
      "require": "./dist/custom-doc-editor.umd.js"
    },
    "./styles": "./dist/custom-doc-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-character-count": "^2.11.0",
    "@tiptap/extension-color": "^2.11.0",
    "@tiptap/extension-font-family": "^2.11.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-subscript": "^2.11.0",
    "@tiptap/extension-superscript": "^2.11.0",
    "@tiptap/extension-table": "^2.11.0",
    "@tiptap/extension-table-cell": "^2.11.0",
    "@tiptap/extension-table-header": "^2.11.0",
    "@tiptap/extension-table-row": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/extension-typography": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.143",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/utils": "^3.1.7",
    "@svgdotjs/svg.js": "^3.2.8",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "lucide": "^1.42.0",
    "mermaid": "^12.2.0",
    "pagedjs": "^0.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "react-konva": "^19.3.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-character-count": "^2.11.0",
    "@tiptap/extension-color": "^2.11.0",
    "@tiptap/extension-font-family": "^2.11.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-subscript": "^2.11.0",
    "@tiptap/extension-superscript": "^2.11.0",
    "@tiptap/extension-table": "^2.11.0",
    "@tiptap/extension-table-cell": "^2.11.0",
    "@tiptap/extension-table-header": "^2.11.0",
    "@tiptap/extension-table-row": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/extension-typography": "^2.11.0",
